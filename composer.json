{
    "name": "axolotlbucketlabs/simple-economy",
    "description": "An economy plugin powered by SimpleSQL hybrid SQL-YAML storage",
    "type": "pocketmine-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "axolotl-pm/pocketmine-mp": "5.51.1",
        "axolotlbucketlabs/economy-provider-api": "dev-main#39539bd4985564db1bbf93103ded602fb8c04846 as 2.0.0",
        "axolotlbucketlabs/simple-sql": "dev-main#a1763696c974a1fc02632b4804be1e982a6dd982 as 2.0.0",
        "sof3/await-generator": "dev-devtools-shading-compat as 3.6.1",
        "sof3/libasynql": "dev-master#270f8ae93e3271206eadd42ca81862ab9a54f322"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/axolotl-pm/PocketMine-MP",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/AxolotlBucketLabs/EconomyProviderAPI",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/AxolotlBucketLabs/SimpleSQL",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/AxolotlBucketLabs/await-generator",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/poggit/libasynql",
            "no-api": true
        }
    ],
    "autoload": {
        "psr-4": {
            "AxolotlBucketLabs\\SimpleEconomy\\": "src/AxolotlBucketLabs/SimpleEconomy/"
        }
    },
    "config": {
        "allow-plugins": false,
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
